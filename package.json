{
  "name": "crowdsense",
  "version": "0.1.0",
  "description": "CrowdSense — venue floor-plan editor for crowd-flow modeling (HackCMU)",
  "main": "src/main/main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "package": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.crowdsense.app",
    "productName": "CrowdSense",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "optimizer",
        "to": "optimizer",
        "filter": [
          "**/*",
          "!__pycache__",
          "!**/__pycache__/**",
          "!data/**",
          "!*.png",
          "!*.gif",
          "!legacy_gate_model/**"
        ]
      },
      {
        "from": "examples",
        "to": "examples"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  }
}
